# Copia este archivo como ".env" y reemplaza los valores con los tuyos.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Cadena de conexión de Neon (botón "Connect").
# Al final, deja solo: ?sslmode=verify-full
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@SERVIDOR.neon.tech/neondb?sslmode=verify-full

# Puerto donde escucha la API en tu computadora
PORT=3000
